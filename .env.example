# Environment: development | production | test
ENVIRONMENT=development
DEBUG=false

# PostgreSQL Database Connection
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/stockguard
FALLBACK_DATABASE_URL=sqlite:///./stockguard.db

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://<rabbitmq_user>:<rabbitmq_password>@localhost:5672/
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=stockguard.topic
RABBITMQ_DLQ_EXCHANGE=stockguard.dlq
RABBITMQ_RETRY_LIMIT=3

# Business Domain Defaults
DEFAULT_RESERVATION_TTL_SECONDS=600
OUTBOX_POLL_INTERVAL_SECONDS=1.0
EXPIRATION_POLL_INTERVAL_SECONDS=2.0

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["*"]
